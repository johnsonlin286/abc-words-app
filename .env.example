# NESIO backend (Socket.IO + REST). Android emulator: http://10.0.2.2:3001 (the Mac's localhost).
# A phone on the same Wi-Fi: the Mac's LAN IP, e.g. http://192.168.1.10:3101
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
# Google Cloud "Web application" OAuth client ID: the audience of the ID token the backend checks.
# Not a secret (it ships inside the app anyway).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=917923038071-gd8tgt6t0daf2frlm1qjactm84ktptu4.apps.googleusercontent.com
